# Supabase SSR
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only seed/order credentials. Never expose these as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: promote this existing Auth user to admin during seeding.
SUPABASE_ADMIN_EMAIL=

# Stripe (CHF, TWINT + cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email receipts via Resend
# https://resend.com/api-keys — verify your domain, then set FROM to that domain
RESEND_API_KEY=
RESEND_FROM=Safran Romanshorn <bestellung@safran-solothurn.ch>
# Kitchen / owner inbox for new-order alerts (comma-separated allowed)
ORDER_NOTIFY_EMAIL=safran.swiss1@gmail.com
# Public site origin used in order-status links inside emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public restaurant contact
NEXT_PUBLIC_RESTAURANT_PHONE=+41712445533
NEXT_PUBLIC_RESTAURANT_EMAIL=info@safran-solothurn.ch

# Brother A4 bill printing (DCP-L2520DW via PrintNode)
# Providers: log (dev, no hardware) | printnode
PRINTER_PROVIDER=log
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
# Protects GET/POST /api/print/process for cron retries
PRINT_WORKER_SECRET=
